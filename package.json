{
	"name": "mark-bricks-monorepo",
	"private": true,
	"version": "0.0.0",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev:tauri": "pnpm --filter mark-bricks-desktop dev",
		"build:tauri": "pnpm --filter mark-bricks-desktop build",
		"tauri": "pnpm --filter mark-bricks-desktop tauri",
		"version:tauri": "pnpm --filter mark-bricks-desktop exec npm version",
		"version:tauri:preview": "pnpm --filter mark-bricks-desktop version:preview",
		"version:vscode": "pnpm --filter mark-bricks-vscode exec npm version",
		"version:vscode:preview": "pnpm --filter mark-bricks-vscode version:preview",
		"storybook": "pnpm --filter @mark-bricks/storybook storybook",
		"build-storybook": "pnpm --filter @mark-bricks/storybook build-storybook",
		"lint:js": "eslint .",
		"lint:js:fix": "eslint . --fix",
		"lint:css": "stylelint \"{packages,apps}/**/*.{css,scss}\"",
		"lint:css:fix": "stylelint \"{packages,apps}/**/*.{css,scss}\" --fix",
		"lint": "npm run lint:js && npm run lint:css",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
		"i18n:make-pot": "pnpm -r --if-present i18n:make-pot",
		"i18n:make-po": "pnpm -r --if-present i18n:make-po",
		"i18n:make-json": "pnpm -r --if-present i18n:make-json",
		"type-check": "tsc -p packages/editor/tsconfig.json --noEmit && tsc -p apps/tauri/tsconfig.json --noEmit && tsc -p apps/vscode/tsconfig.json --noEmit",
		"test": "pnpm -r --if-present test",
		"format": "prettier --write .",
		"prepare": "husky",
		"postinstall": "pnpm i18n:make-json"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,yml,yaml,md}": [
			"prettier --write"
		],
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix"
		],
		"*.{css,scss}": [
			"prettier --write",
			"stylelint --fix"
		],
		"apps/tauri/src-tauri/**/*.rs": [
			"rustfmt --edition 2021"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@wordpress/eslint-plugin": "^25.9.0",
		"@wordpress/prettier-config": "^4.53.0",
		"@wordpress/stylelint-config": "^24.2.0",
		"conventional-changelog-cli": "^5.0.0",
		"eslint": "^10.9.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "npm:wp-prettier@3.0.3",
		"stylelint": "^16.26.1",
		"stylelint-scss": "^6.14.0",
		"typescript": "~5.8.3"
	},
	"pnpm": {
		"packageExtensions": {
			"@wp-blocks/make-pot": {
				"dependencies": {
					"minimatch": "^10"
				}
			}
		}
	}
}
