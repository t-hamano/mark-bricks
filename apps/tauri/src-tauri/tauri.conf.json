{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "MarkBricks",
	"version": "0.5.1",
	"identifier": "com.markbricks.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "MarkBricks",
				"width": 1000,
				"height": 700,
				"minWidth": 400,
				"minHeight": 500,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' asset: http://asset.localhost data: https:",
				"font-src": "'self'",
				"worker-src": "'self'",
				"connect-src": "'self' ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'none'",
				"frame-ancestors": "'self'",
				"frame-src": "'self'"
			},
			"assetProtocol": {
				"enable": true,
				"scope": [ "**" ]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"fileAssociations": [
			{
				"ext": [ "md", "markdown" ],
				"name": "Markdown",
				"role": "Editor",
				"mimeType": "text/markdown"
			}
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RkQzRkNBNjhBMUI5NjgKUldSb3VhRm95ai85MWNoWXNkVVdpTTBmTjRmMURMSy9GbGJ1emx5QXplWTZFMnJDYVRSLzRrd2YK",
			"endpoints": [
				"https://github.com/t-hamano/mark-bricks/releases/latest/download/latest.json"
			]
		}
	}
}
