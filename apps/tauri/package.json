{
	"name": "mark-bricks-desktop",
	"private": true,
	"version": "0.9.1",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"bugs": {
		"url": "https://github.com/t-hamano/mark-bricks/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"build:debug": "tauri build --debug --no-bundle",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
		"e2e:smoke": "node scripts/smoke-launch.mjs",
		"i18n:make-pot": "mb-i18n make-pot",
		"i18n:make-po": "mb-i18n make-po",
		"i18n:make-json": "mb-i18n make-json",
		"preversion": "node scripts/check-releasable.mjs",
		"version": "pnpm exec conventional-changelog -p angular -i CHANGELOG.md -s --tag-prefix tauri-v --commit-path . --commit-path ../../packages/editor && node scripts/bump-version.mjs",
		"version:preview": "pnpm exec conventional-changelog -p angular --tag-prefix tauri-v --commit-path . --commit-path ../../packages/editor"
	},
	"dependencies": {
		"@mark-bricks/editor": "workspace:*",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2",
		"@tauri-apps/plugin-store": "^2",
		"@tauri-apps/plugin-updater": "^2",
		"@wordpress/base-styles": "^12.1.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/compose": "^8.6.0",
		"@wordpress/data": "^10.53.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/icons": "^15.4.0",
		"@wordpress/interface": "^9.38.0",
		"@wordpress/keyboard-shortcuts": "^5.53.0",
		"@wordpress/keycodes": "^4.53.0",
		"@wordpress/preferences": "^4.53.0",
		"@wordpress/ui": "^0.20.0",
		"clsx": "^2.1.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@mark-bricks/i18n-tools": "workspace:*",
		"@tauri-apps/cli": "^2",
		"@types/node": "^26.3.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.0",
		"jsdom": "^30.0.1",
		"sass": "^1.103.1",
		"typescript": "~5.8.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
