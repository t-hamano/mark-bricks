{
	"name": "mark-bricks-vscode",
	"displayName": "MarkBricks",
	"description": "Visual markdown editor powered by the WordPress block editor.",
	"version": "0.0.0",
	"private": true,
	"publisher": "akihamano",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"markdown",
		"editor",
		"visual",
		"wysiwyg"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"customEditors": [
			{
				"viewType": "markBricks.visualEditor",
				"displayName": "MarkBricks (Visual)",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "option"
			}
		],
		"commands": [
			{
				"command": "markBricks.openVisual",
				"title": "Open with MarkBricks"
			},
			{
				"command": "markBricks.openText",
				"title": "Open with Text Editor"
			}
		],
		"keybindings": [
			{
				"command": "markBricks.suppressUndo",
				"key": "ctrl+z",
				"mac": "cmd+z",
				"when": "activeCustomEditorId == 'markBricks.visualEditor'"
			},
			{
				"command": "markBricks.suppressRedo",
				"key": "ctrl+shift+z",
				"mac": "shift+cmd+z",
				"when": "activeCustomEditorId == 'markBricks.visualEditor'"
			},
			{
				"command": "markBricks.suppressRedo",
				"key": "ctrl+y",
				"when": "activeCustomEditorId == 'markBricks.visualEditor' && !isMac"
			}
		],
		"configuration": {
			"title": "MarkBricks",
			"properties": {}
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"dev": "node scripts/build.mjs --watch",
		"package": "pnpm run build && vsce package --no-dependencies",
		"version": "pnpm exec conventional-changelog -p angular -i CHANGELOG.md -s --tag-prefix vscode-v --commit-path . --commit-path ../../packages/editor && node scripts/bump-version.mjs",
		"version:preview": "pnpm exec conventional-changelog -p angular --tag-prefix vscode-v --commit-path . --commit-path ../../packages/editor"
	},
	"dependencies": {
		"@mark-bricks/editor": "workspace:*",
		"@wordpress/base-styles": "^13.0.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.3.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/vscode": "^1.85.0",
		"@vitejs/plugin-react": "^6.1.0",
		"@vscode/vsce": "^3",
		"esbuild": "^0.28.2",
		"sass": "^1.103.1",
		"typescript": "~5.8.3",
		"vite": "^8.2.2"
	}
}
