{
	"name": "mark-bricks-vscode",
	"displayName": "MarkBricks",
	"description": "%description%",
	"version": "0.4.0",
	"private": true,
	"publisher": "aki-hamano",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"icon": "icons/icon.png",
	"preview": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/t-hamano/mark-bricks.git",
		"directory": "apps/vscode"
	},
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"keywords": [
		"markdown",
		"editor",
		"visual",
		"wysiwyg"
	],
	"main": "./dist/extension.cjs",
	"l10n": "./l10n",
	"activationEvents": [
		"onLanguage:markdown",
		"onWebviewPanel:markBricks.marpPreview"
	],
	"contributes": {
		"customEditors": [
			{
				"viewType": "markBricks.visualEditor",
				"displayName": "%customEditor.visualEditor.displayName%",
				"selector": [
					{
						"filenamePattern": "*.md"
					}
				],
				"priority": "option"
			}
		],
		"commands": [
			{
				"command": "markBricks.openVisual",
				"title": "%command.openVisual.title%"
			},
			{
				"command": "markBricks.openText",
				"title": "%command.openText.title%"
			},
			{
				"command": "markBricks.openMarpPreview",
				"title": "%command.openMarpPreview.title%",
				"icon": "$(open-preview)"
			},
			{
				"command": "markBricks.exportSlideDeck",
				"title": "%command.exportSlideDeck.title%"
			},
			{
				"command": "markBricks.showQuickPick",
				"title": "%command.showQuickPick.title%",
				"icon": {
					"light": "icons/icon-light.svg",
					"dark": "icons/icon-dark.svg"
				}
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "markBricks.openMarpPreview",
					"when": "markBricks.isMarp && activeCustomEditorId != 'markBricks.visualEditor'",
					"group": "navigation"
				},
				{
					"command": "markBricks.showQuickPick",
					"when": "resourceLangId == markdown || activeCustomEditorId == 'markBricks.visualEditor'",
					"group": "navigation@100"
				}
			],
			"commandPalette": [
				{
					"command": "markBricks.openMarpPreview",
					"when": "markBricks.isMarp"
				},
				{
					"command": "markBricks.exportSlideDeck",
					"when": "markBricks.isMarp"
				},
				{
					"command": "markBricks.showQuickPick",
					"when": "resourceLangId == markdown || activeCustomEditorId == 'markBricks.visualEditor'"
				}
			]
		},
		"keybindings": [
			{
				"command": "markBricks.suppressUndo",
				"key": "ctrl+z",
				"mac": "cmd+z",
				"when": "activeCustomEditorId == 'markBricks.visualEditor'"
			},
			{
				"command": "markBricks.suppressRedo",
				"key": "ctrl+shift+z",
				"mac": "shift+cmd+z",
				"when": "activeCustomEditorId == 'markBricks.visualEditor'"
			},
			{
				"command": "markBricks.suppressRedo",
				"key": "ctrl+y",
				"when": "activeCustomEditorId == 'markBricks.visualEditor' && !isMac"
			}
		],
		"configuration": {
			"title": "MarkBricks",
			"properties": {
				"markBricks.theme": {
					"type": "string",
					"scope": "resource",
					"enum": [
						"auto",
						"light",
						"dark"
					],
					"enumItemLabels": [
						"%config.theme.auto%",
						"%config.theme.light%",
						"%config.theme.dark%"
					],
					"default": "auto",
					"order": 0,
					"description": "%config.theme.description%"
				},
				"markBricks.showListViewByDefault": {
					"type": "boolean",
					"scope": "resource",
					"default": false,
					"order": 1,
					"description": "%config.showListViewByDefault.description%"
				},
				"markBricks.showBlockBreadcrumbs": {
					"type": "boolean",
					"scope": "resource",
					"default": true,
					"order": 2,
					"description": "%config.showBlockBreadcrumbs.description%"
				},
				"markBricks.topToolbar": {
					"type": "boolean",
					"scope": "resource",
					"default": false,
					"order": 3,
					"description": "%config.topToolbar.description%"
				},
				"markBricks.spotlightMode": {
					"type": "boolean",
					"scope": "resource",
					"default": false,
					"order": 4,
					"description": "%config.spotlightMode.description%"
				},
				"markBricks.contentWidth": {
					"type": "integer",
					"scope": "resource",
					"default": 700,
					"minimum": 400,
					"maximum": 1600,
					"order": 5,
					"description": "%config.contentWidth.description%"
				},
				"markBricks.fontSize": {
					"type": "integer",
					"scope": "resource",
					"default": 13,
					"minimum": 10,
					"maximum": 24,
					"order": 6,
					"description": "%config.fontSize.description%"
				},
				"markBricks.fontFamily": {
					"type": "string",
					"scope": "resource",
					"enum": [
						"system",
						"sans-serif",
						"serif",
						"monospace",
						"handwriting"
					],
					"enumItemLabels": [
						"%config.fontFamily.system%",
						"%config.fontFamily.sansSerif%",
						"%config.fontFamily.serif%",
						"%config.fontFamily.monospace%",
						"%config.fontFamily.handwriting%"
					],
					"default": "system",
					"order": 7,
					"description": "%config.fontFamily.description%"
				}
			}
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"dev": "node scripts/build.mjs --watch",
		"package": "pnpm run build && vsce package --no-dependencies --readme-path MARKETPLACE.md --baseContentUrl https://github.com/t-hamano/mark-bricks/blob/HEAD/apps/vscode --baseImagesUrl https://github.com/t-hamano/mark-bricks/raw/HEAD/apps/vscode",
		"i18n:make-pot": "mb-i18n make-pot",
		"i18n:make-po": "mb-i18n make-po",
		"i18n:make-json": "mb-i18n make-json",
		"version": "pnpm exec conventional-changelog -p angular -i CHANGELOG.md -s --tag-prefix vscode-v --commit-path . --commit-path ../../packages/editor --commit-path ../../packages/image-path --commit-path ../../packages/marp-preview && node scripts/bump-version.mjs",
		"version:preview": "pnpm exec conventional-changelog -p angular --tag-prefix vscode-v --commit-path . --commit-path ../../packages/editor --commit-path ../../packages/image-path --commit-path ../../packages/marp-preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e:smoke": "vscode-test"
	},
	"dependencies": {
		"@mark-bricks/editor": "workspace:*",
		"@mark-bricks/image-path": "workspace:*",
		"@mark-bricks/marp-preview": "workspace:*",
		"@marp-team/marp-cli": "^4.5.1",
		"@wordpress/base-styles": "^13.2.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/ui": "^0.23.0",
		"react": "^19.3.0",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@mark-bricks/fixtures": "workspace:*",
		"@mark-bricks/i18n-tools": "workspace:*",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.2.4",
		"@types/vscode": "^1.137.0",
		"@vitejs/plugin-react": "^6.1.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4",
		"esbuild": "^0.28.2",
		"sass": "^1.105.1",
		"typescript": "~6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"vscode-uri": "^3.2.0"
	}
}
