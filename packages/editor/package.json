{
	"name": "@mark-bricks/editor",
	"version": "0.0.0",
	"private": true,
	"description": "Visual markdown block editor.",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"sideEffects": [
		"*.css",
		"*.scss",
		"./src/store/index.ts"
	],
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./ai": {
			"types": "./src/ai.ts",
			"default": "./src/ai.ts"
		},
		"./font-families": {
			"types": "./src/font-families.ts",
			"default": "./src/font-families.ts"
		},
		"./marp-patterns": {
			"types": "./src/marp-patterns/index.ts",
			"default": "./src/marp-patterns/index.ts"
		},
		"./marp": {
			"types": "./src/marp.ts",
			"default": "./src/marp.ts"
		},
		"./vite-dedupe": {
			"types": "./vite-dedupe.d.mts",
			"default": "./vite-dedupe.mjs"
		}
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"slide-patterns:update": "vitest run src/marp-patterns/render-previews -u",
		"i18n:make-pot": "mb-i18n make-pot",
		"i18n:make-po": "mb-i18n make-po",
		"i18n:make-json": "mb-i18n make-json",
		"i18n:fetch-gutenberg": "node ./scripts/fetch-gutenberg.mjs"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.15",
		"@fontsource/lato": "^5.3.0",
		"@mark-bricks/katex-fonts": "workspace:*",
		"@marp-team/marp-core": "^4.4.0",
		"@wordpress/base-styles": "^15.0.0",
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/block-library": "^12.1.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/compose": "^9.1.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/dataviews": "^22.0.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/escape-html": "^4.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/icons": "^20.0.0",
		"@wordpress/keyboard-shortcuts": "^6.1.0",
		"@wordpress/keycodes": "^5.1.0",
		"@wordpress/private-apis": "^3.1.0",
		"@wordpress/rich-text": "^8.1.0",
		"@wordpress/style-runtime": "^0.15.0",
		"@wordpress/theme": "^4.0.0",
		"@wordpress/ui": "^0.26.0",
		"clsx": "^2.1.1",
		"codemirror-lang-mermaid": "^0.5.0",
		"diff": "^9.0.0",
		"hast-util-from-html": "^2.1.0",
		"katex": "^0.19.1",
		"mdast-util-math": "^3.0.0",
		"mdast-util-to-markdown": "^2.2.3",
		"mermaid": "^12.3.0",
		"micromark-extension-math": "^3.1.0",
		"monaco-editor": "^0.57.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"unified": "^11.0.5",
		"uuid": "^14.0.3",
		"yaml": "^2.9.1"
	},
	"peerDependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@mark-bricks/fixtures": "workspace:*",
		"@mark-bricks/i18n-tools": "workspace:*",
		"@mark-bricks/marp-preview": "workspace:*",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"fflate": "^0.8.3",
		"jsdom": "^31.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.108.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	}
}
