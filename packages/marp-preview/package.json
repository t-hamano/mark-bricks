{
	"name": "@mark-bricks/marp-preview",
	"version": "0.0.0",
	"private": true,
	"description": "Renders Marp slide decks for the hosts' slide previews and exports, and shows them in the previews.",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"exports": {
		"./render": {
			"types": "./src/render/index.ts",
			"default": "./src/render/index.ts"
		},
		"./export": {
			"types": "./src/export/index.ts",
			"default": "./src/export/index.ts"
		},
		"./browser": {
			"types": "./src/browser/index.ts",
			"default": "./src/browser/index.ts"
		},
		"./controls": {
			"types": "./src/controls/index.ts",
			"default": "./src/controls/index.ts"
		}
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"i18n:make-pot": "mb-i18n make-pot",
		"i18n:make-po": "mb-i18n make-po",
		"i18n:make-json": "mb-i18n make-json"
	},
	"dependencies": {
		"@fontsource/lato": "^5.3.0",
		"@fontsource/roboto-mono": "^5.3.0",
		"@mark-bricks/editor": "workspace:*",
		"@marp-team/marp-core": "^4.4.0",
		"@wordpress/i18n": "^6.29.0",
		"@wordpress/icons": "^17.0.0",
		"@wordpress/theme": "^2.2.0",
		"@wordpress/ui": "^0.23.0"
	},
	"peerDependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@mark-bricks/fixtures": "workspace:*",
		"@mark-bricks/i18n-tools": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
